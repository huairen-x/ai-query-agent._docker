[Unit]
Description=AI Query Agent - MCP NL2SQL Gateway
After=network-online.target headroom-proxy.service
Wants=headroom-proxy.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
WorkingDirectory=%h/project/ai-query-agent._docker
EnvironmentFile=%h/.config/ai-query-agent/agent.env
Environment=PATH=/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/project/ai-query-agent._docker/scripts/run-agent.sh
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
TimeoutStopSec=40

[Install]
WantedBy=default.target
