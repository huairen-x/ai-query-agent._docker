# ============================================================
# AI Query Agent 环境配置
# ============================================================

# --- 运行模式 ---
# MOCK_MODE=true: 使用内置 Mock 数据，无需连接真实 Hive
MOCK_MODE=true
DEBUG=false

# --- 服务端口 ---
MCP_HTTP_PORT=8080
MCP_HTTP_HOST=0.0.0.0

# --- Hive 配置（MOCK_MODE=false 时生效） ---
HIVE_HOST=localhost
HIVE_PORT=10000
HIVE_USER=hive
HIVE_PASSWORD=
HIVE_DATABASE=default

# --- 认证 ---
# AUTH_ENABLED=false: 关闭认证（开发环境）
# API_KEYS: 逗号分隔的 API Key 列表
AUTH_ENABLED=false
API_KEYS=dev-key-1,dev-key-2

# --- 速率限制 ---
# RATE_LIMIT_ENABLED=false: 关闭速率限制（开发环境）
RATE_LIMIT_ENABLED=false
RATE_LIMIT_GLOBAL_RPS=50.0

# --- CORS ---
# CORS_ORIGINS: 逗号分隔的允许域名，留空使用默认 localhost
# 生产环境请设置为具体域名，如 https://app.example.com
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Headroom 压缩 ---
HEADROOM_ENABLED=true
HEADROOM_TARGET_RATIO=0.3

# --- 缓存 ---
CACHE_TTL=300

# --- LangGraph ---
LANGGRAPH_CHECKPOINT=true

# --- 模板引擎 ---
TEMPLATE_ENABLED=true
TEMPLATE_PATH=templates/templates.yaml