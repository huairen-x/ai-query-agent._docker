# ==============================================================
# 数据目录（SQLite 缓存 + 审计）
# ==============================================================
# 默认 <repo>/data；systemd 部署下由 deploy-nix.sh 写为绝对路径
# （EnvironmentFile 不做变量展开）
AGENT_DATA_DIR=

# ==============================================================
# 数仓（无 Hive 环境时的 Mock 数据源）
# ==============================================================
# 单次查询最多返回行数，超出部分截断并在响应里标记 truncated
MOCK_MAX_ROWS=500
# mock 时钟固定为 2025-01-01，数据区间 2024-01-01 ~ 2024-12-31，
# "最近 N 天" 类相对时间查询因此永远有数据，无需配置

# ==============================================================
# Headroom 压缩（SmartCrusher 本地压缩 + 统计上报）
# ==============================================================
HEADROOM_ENABLED=true
HEADROOM_PROXY_URL=http://127.0.0.1:8787
# SmartCrusher 触发阈值（真实小负载也能压缩）
HEADROOM_MIN_ITEMS=2
HEADROOM_MIN_TOKENS=20
# 压缩后保留的最大条目数
HEADROOM_MAX_ITEMS_AFTER_CRUSH=15
# 单次上报内容保护性截断上限（字符）
HEADROOM_REPORT_MAX_CHARS=2000000
# 统计上报开关与上报线程数
HEADROOM_REPORT_ENABLED=true
HEADROOM_REPORT_WORKERS=2
# 调试日志开关（[MCP]/[node]/[headroom-report] 等，生产可设 false）
HEADROOM_DEBUG=true

# ==============================================================
# MCP HTTP 网关
# ==============================================================
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8080
# gunicorn 进程/线程数；SSE 会话表是进程内字典，MCP_WORKERS 必须为 1
MCP_WORKERS=1
MCP_THREADS=16
# gunicorn 或 flask（回退到 Flask 内置服务器，用于排查 SSE 兼容问题）
MCP_SERVER=gunicorn
# 请求体大小上限（字节）
MCP_MAX_BODY_BYTES=262144

# ==============================================================
# 后台维护（过期缓存与审计回收）
# ==============================================================
# 回收间隔（秒）；<=0 关闭后台维护
CACHE_CLEANUP_INTERVAL_SEC=300
# 审计日志与会话保留天数
AUDIT_RETENTION_DAYS=90

# ==============================================================
# 日志与追踪
# ==============================================================
# 日志级别；所有日志行带 [trace_id]，与审计记录共用同一 ID
AGENT_LOG_LEVEL=INFO
# true 时输出 JSON 行日志（便于日志系统采集），默认 text
AGENT_LOG_JSON=false

# ==============================================================
# Mock LLM upstream（headroom proxy 的上游）
# ==============================================================
MOCK_UPSTREAM_HOST=127.0.0.1
MOCK_UPSTREAM_PORT=9999

# ==============================================================
# venv 依赖安装
# ==============================================================
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# ==============================================================
# 关于真实 Hive / 真实 LLM
# ==============================================================
# 本项目不在 MCP 内调用任何 LLM：SQL 由调用方（Trae 等 MCP 客户端）
# 用其自有 token 生成，服务端只负责元数据、执行、审查与解读。
# 接入真实 Hive 时改写 datasource/ 下的实现即可，CATALOG 与
# describe/search/execute 三个接口保持不变。
